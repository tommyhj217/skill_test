{
  "tools": {
    "enableHooks": true
  },
  "hooks": {
    "enabled": true,
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agents/skills/work-history/scripts/hook_logger.py\" --runner gemini"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agents/skills/work-history/scripts/hook_logger.py\" --runner gemini"
          }
        ]
      }
    ]
  }
}
