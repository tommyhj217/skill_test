{
  "label": "테스트 계획",
  "icon": "🧪",
  "inputs": [
    {
      "name": "level",
      "label": "테스트 수준",
      "type": "select",
      "options": [
        "smoke",
        "regression",
        "full"
      ],
      "default": "regression"
    },
    {
      "name": "regions",
      "label": "대상 지역",
      "type": "text",
      "default": "{regions}"
    },
    {
      "name": "notes",
      "label": "추가 요청",
      "type": "textarea",
      "default": ""
    }
  ],
  "prompt": "/model-test-plan {jira_key} ({model_code}) {level} 테스트 계획 — 지역: {regions}, 마감: {due} {notes}",
  "output": "markdown",
  "agent": {
    "role": "qa",
    "product_lines": [
      "*"
    ],
    "exclude_product_lines": [
      "액세서리"
    ],
    "order": 20
  },
  "applies_to": {}
}
