{
  "_doc": "AI runner adapters. {prompt} {session} {skill} are substituted. 'format' picks the output parser in scripts/runners.py (claude-stream | codex-jsonl | gemini-stream | text). Add any other CLI with format=text.",
  "claude": {
    "label": "Claude Code",
    "aliases": ["claude-code"],
    "bin": "claude",
    "run": ["claude", "-p", "{prompt}", "--output-format", "stream-json", "--verbose"],
    "resume": ["claude", "-p", "{prompt}", "--resume", "{session}", "--output-format", "stream-json", "--verbose"],
    "format": "claude-stream",
    "skill_syntax": "/{skill}",
    "extra_args_env": "WORK_HISTORY_CLAUDE_ARGS",
    "strip_env": ["CLAUDE_CODE_SESSION_ID", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"]
  },
  "codex": {
    "label": "OpenAI Codex",
    "bin": "codex",
    "run": ["codex", "exec", "--json", "--skip-git-repo-check", "{prompt}"],
    "resume": ["codex", "exec", "--json", "--skip-git-repo-check", "resume", "{session}", "{prompt}"],
    "format": "codex-jsonl",
    "skill_syntax": "${skill}",
    "extra_args_env": "WORK_HISTORY_CODEX_ARGS"
  },
  "copilot": {
    "label": "GitHub Copilot CLI",
    "bin": "copilot",
    "run": ["copilot", "-p", "{prompt}", "-s"],
    "resume": ["copilot", "-p", "{prompt}", "-s", "--resume", "{session}"],
    "format": "text",
    "skill_syntax": "Use the {skill} skill:",
    "extra_args_env": "WORK_HISTORY_COPILOT_ARGS",
    "_note": "programmatic mode needs tool permission flags, e.g. WORK_HISTORY_COPILOT_ARGS='--allow-all-tools'"
  },
  "gemini": {
    "label": "Gemini CLI",
    "bin": "gemini",
    "run": ["gemini", "-p", "{prompt}", "--output-format", "stream-json"],
    "resume": ["gemini", "--resume", "{session}", "-p", "{prompt}", "--output-format", "stream-json"],
    "format": "gemini-stream",
    "skill_syntax": "Use the {skill} skill:",
    "extra_args_env": "WORK_HISTORY_GEMINI_ARGS"
  }
}
